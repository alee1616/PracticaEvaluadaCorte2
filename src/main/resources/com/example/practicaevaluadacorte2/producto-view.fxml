<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="750.0" prefWidth="900.0" spacing="15.0" style="-fx-background-color: #F4F6F8; -fx-font-family: 'Segoe UI', Arial;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.practicaevaluadacorte2.controller.ProductoController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Catálogo de Productos - Papelería Campus" />

    <GridPane hgap="15.0" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5;" vgap="12.0">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495E;" text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtCodigo" promptText="Ej, P001" style="-fx-background-radius: 3; -fx-border-color: #E5E7EB; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495E;" text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombre" prefWidth="250.0" promptText="Nombre del producto" style="-fx-background-radius: 3; -fx-border-color: #E5E7EB; -fx-border-radius: 3;" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495E;" text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="cmbCategoriaForm" prefWidth="150.0" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495E;" text="Precio (C$):" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtPrecio" promptText="0.00" style="-fx-background-radius: 3; -fx-border-color: #E5E7EB; -fx-border-radius: 3;" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495E;" text="Stock:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtStock" promptText="0" style="-fx-background-radius: 3; -fx-border-color: #E5E7EB; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495E;" text="ID:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <TextField fx:id="txtId" disable="true" editable="false" promptText="Automático" style="-fx-background-radius: 3; -fx-border-color: #E5E7EB; -fx-border-radius: 3;" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <HBox spacing="10.0">
        <Button onAction="#onLimpiarFormulario" prefWidth="120.0" style="-fx-background-color: #9CA3AF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Nuevo / Limpiar" />
        <Button onAction="#onGuardar" prefWidth="100.0" style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Guardar" />
        <Button onAction="#onActualizar" prefWidth="100.0" style="-fx-background-color: #F5A623; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Actualizar" />
        <Button onAction="#onEliminar" prefWidth="100.0" style="-fx-background-color: #D9534F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Eliminar" />
    </HBox>

    <Separator style="-fx-background-color: #D1D5DB;" />

    <!-- Sección de Búsqueda y Filtros -->
    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Búsqueda y Filtros" />
    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-padding: 12; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5;">
        <VBox spacing="5.0">
            <Label style="-fx-text-fill: #555555; -fx-font-size: 11px;" text="Nombre o Código:" />
            <TextField fx:id="txtBuscarTexto" prefWidth="180.0" promptText="Buscar..." style="-fx-background-radius: 3; -fx-border-color: #E5E7EB;" />
        </VBox>

        <VBox spacing="5.0">
            <Label style="-fx-text-fill: #555555; -fx-font-size: 11px;" text="Categoría:" />
            <ComboBox fx:id="cmbBuscarCategoria" prefWidth="130.0" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB;" />
        </VBox>

        <CheckBox fx:id="chkSoloExistencias" style="-fx-text-fill: #34495E;" text="Solo con existencias" />

        <Button onAction="#onBuscar" prefWidth="80.0" style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Buscar">
            <HBox.margin>
                <Insets left="10.0" />
            </HBox.margin></Button>
        <Button onAction="#onLimpiarFiltros" prefWidth="100.0" style="-fx-background-color: #9CA3AF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Limpiar filtros" />
        <Button onAction="#onRecargar" prefWidth="90.0" style="-fx-background-color: #6C7A89; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Recargar" />
    </HBox>

    <Label fx:id="lblContador" style="-fx-font-weight: bold; -fx-text-fill: #4A90E2;" text="Registros visibles: 0" />

    <TableView fx:id="tblProductos" style="-fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 3;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="101.39999651908875" text="ID" />
            <TableColumn fx:id="colCodigo" prefWidth="102.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="212.80003356933594" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="150.39993286132812" text="Categoría" />
            <TableColumn fx:id="colPrecio" prefWidth="106.0" text="Precio (C$)" />
            <TableColumn fx:id="colStock" prefWidth="177.60003662109375" text="Stock" />
        </columns>
    </TableView>
</VBox>